{
  "name": "moonmolt",
  "version": "0.8.0",
  "description": "SQLite migrations: rehearse, upgrade, retain your data",
  "repository": { "type": "git", "url": "https://github.com/q0w1ertyuiop/MoonMolt.git" },
  "type": "module",
  "engines": { "node": ">=24.10.0" },
  "bin": { "moonmolt": "node/cli.mjs" },
  "exports": { ".": { "types": "./node/runtime.d.mts", "import": "./node/runtime.mjs" } },
  "files": ["dist/", "node/*.mjs", "node/*.d.mts", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "docs/"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo": "node examples/demo.mjs",
    "demo:embedded": "node examples/embedded.mjs",
    "demo:preserve": "node examples/preservation.mjs",
    "prepack": "npm run build"
  },
  "license": "Apache-2.0"
}
